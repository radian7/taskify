// Dev container for Taskify (https://containers.dev). Setup notes for Docker in WSL and for Podman:
// docs/devcontainer.md.
{
  "name": "Taskify (.NET 10 + Aspire)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0-noble",

  "features": {
    // Aspire starts PostgreSQL as a container. It has to run inside this container (Docker-in-Docker), because
    // the services reach it on localhost. With the host's Docker socket the published port would sit on the
    // host and the services could not reach it.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // scripts/verify.ps1 and scripts/init-dev-secrets.ps1.
    "ghcr.io/devcontainers/features/powershell:1": {},
    // Python for .github/scripts/check-openapi-drift.sh, Node for the AsyncAPI check (npx @asyncapi/cli).
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  "containerEnv": {
    // Directory.Build.props sends the build output to .artifacts/, so the Linux build never overwrites the
    // Windows bin/ and obj/ of a checkout shared with the host.
    "TASKIFY_DEVCONTAINER": "true",
    // Where "dotnet dev-certs https --trust" puts the certificate on Linux. The services call each other
    // over HTTPS (R16) and trust the development certificate through OpenSSL.
    "SSL_CERT_DIR": "/etc/ssl/certs:/home/vscode/.aspnet/dev-certs/trust",
    // E2E tests: Playwright's Chromium (installed by post-create.sh) instead of Google Chrome.
    "TASKIFY_E2E_BROWSER": "chromium",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },

  "mounts": [
    // Survive a container rebuild. The secrets especially: the PostgreSQL data volume lives on (in the
    // Docker-in-Docker volume) and only opens with the password it was created with.
    "source=taskify-usersecrets-${devcontainerId},target=/home/vscode/.microsoft/usersecrets,type=volume",
    "source=taskify-nuget-${devcontainerId},target=/home/vscode/.nuget/packages,type=volume",
    // Build output on a volume: much faster than a bind mount of a Windows drive.
    "source=taskify-artifacts-${devcontainerId},target=${containerWorkspaceFolder}/.artifacts,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [17100],
  "portsAttributes": {
    "17100": { "label": "Aspire dashboard", "protocol": "https", "onAutoForward": "openBrowser" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },

  "hostRequirements": { "cpus": 4, "memory": "8gb" },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-vscode.powershell",
        "ms-azuretools.vscode-containers",
        "editorconfig.editorconfig",
        "github.vscode-github-actions",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh"
      }
    }
  },

  "remoteUser": "vscode"
}
